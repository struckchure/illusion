{{- if eq .Scaffold.kind "2D" -}}
// Package game is {{ .Project }}, a 2D game built with illusion. The same
// code runs on the desktop (cmd/desktop, make run) and in the browser
// (cmd/web, make serve).
//
// WASD or the arrow keys move; collect the coins.
package game

import (
	"fmt"
	"math/rand/v2"

	rl "github.com/gen2brain/raylib-go/raylib"
	"github.com/mlange-42/ark/ecs"
	"github.com/struckchure/illusion"
	"github.com/struckchure/illusion/asset"
	"github.com/struckchure/illusion/audio"
	"github.com/struckchure/illusion/defaults"
	"github.com/struckchure/illusion/input"
	"github.com/struckchure/illusion/render"
	"github.com/struckchure/illusion/transform"
	"github.com/struckchure/illusion/window"
)

const (
	speed      = 300 // pixels per second
	coins      = 12
	pickupDist = 36
)

// The play area, centered on the origin (+Y is down).
var arena = rl.Vector2{X: 1100, Y: 560}

// Player is the character you move.
type Player struct{}

// Coin is a pickup.
type Coin struct{}

// Game is a resource with the score and the pickup sound.
type Game struct {
	Score  int
	Pickup asset.Handle[audio.Sound]
}

// App is the game, ready to Run.
func App() *illusion.App {
	return illusion.New().
		AddPlugins(defaults.Plugins(defaults.Config{
			Window:    window.Config{Title: "{{ .Project }}"},
			AssetRoot: "assets",
		})).
		AddSystems(illusion.Startup, illusion.Fn3(setup)).
		AddSystems(illusion.Update, illusion.Chain(illusion.Fn3(move), illusion.Fn5(collect))).
		AddSystems(illusion.Render, illusion.Fn1(hud).InSet(render.Draw2D))
}

func setup(
	cmd *illusion.Commands,
	textures *asset.Loader[render.Texture],
	sounds *illusion.Res[asset.Assets[audio.Sound]],
) {
	cmd.Spawn(illusion.C(render.Camera2d{}), illusion.C(transform.FromXY(0, 0)))
	cmd.Spawn(
		illusion.C(Player{}),
		// Loaded from assets/player.png, which web builds bundle into the page.
		illusion.C(render.Sprite{Texture: textures.MustLoad("player.png"), Size: rl.Vector2{X: 64, Y: 64}}),
		illusion.C(transform.FromXYZ(0, 0, 1)),
	)
	for range coins {
		spawnCoin(cmd)
	}
	cmd.InsertResource(illusion.R(&Game{
		Pickup: sounds.Get().Add(audio.SoundFromSamples(audio.Tone(880, 0.12), audio.SampleRate)),
	}))
}

func spawnCoin(cmd *illusion.Commands) {
	x := (rand.Float32() - 0.5) * (arena.X - 60)
	y := (rand.Float32() - 0.5) * (arena.Y - 60)
	cmd.Spawn(
		illusion.C(Coin{}),
		illusion.C(render.Sprite{Color: rl.Gold, Size: rl.Vector2{X: 20, Y: 20}}),
		illusion.C(transform.FromXY(x, y)),
	)
}

func move(
	q *illusion.Query1Where[transform.Transform, illusion.With[Player]],
	keys *illusion.Res[input.Keys],
	t *illusion.Res[illusion.Time],
) {
	k := keys.Get()
	var dir rl.Vector2
	if k.AnyPressed(rl.KeyA, rl.KeyLeft) {
		dir.X--
	}
	if k.AnyPressed(rl.KeyD, rl.KeyRight) {
		dir.X++
	}
	if k.AnyPressed(rl.KeyW, rl.KeyUp) {
		dir.Y--
	}
	if k.AnyPressed(rl.KeyS, rl.KeyDown) {
		dir.Y++
	}
	if dir == (rl.Vector2{}) {
		return
	}
	step := rl.Vector2Scale(rl.Vector2Normalize(dir), speed*t.Get().DeltaSecs())
	q.Each(func(_ ecs.Entity, tr *transform.Transform) {
		tr.Translation.X = rl.Clamp(tr.Translation.X+step.X, -arena.X/2, arena.X/2)
		tr.Translation.Y = rl.Clamp(tr.Translation.Y+step.Y, -arena.Y/2, arena.Y/2)
	})
}

// collect picks up coins the player touches and puts new ones elsewhere.
func collect(
	cmd *illusion.Commands,
	players *illusion.Query1Where[transform.Transform, illusion.With[Player]],
	q *illusion.Query1Where[transform.Transform, illusion.With[Coin]],
	game *illusion.Res[Game],
	sfx *audio.Audio,
) {
	_, player, ok := players.Single()
	if !ok {
		return
	}
	g := game.Get()
	q.Each(func(e ecs.Entity, tr *transform.Transform) {
		// Z only orders sprites, so compare X and Y.
		d := rl.Vector2Distance(rl.Vector2{X: tr.Translation.X, Y: tr.Translation.Y}, rl.Vector2{X: player.Translation.X, Y: player.Translation.Y})
		if d < pickupDist {
			cmd.Despawn(e)
			spawnCoin(cmd)
			g.Score++
			sfx.Play(g.Pickup)
		}
	})
}

func hud(game *illusion.Res[Game]) {
	rl.DrawFPS(10, 10)
	rl.DrawText(fmt.Sprintf("coins %d   WASD / arrows: move", game.Get().Score), 10, 36, 20, rl.RayWhite)
}
{{- else -}}
// Package game is {{ .Project }}, a 3D game built with illusion. The same
// code runs on the desktop (cmd/desktop, make run) and in the browser
// (cmd/web, make serve).
//
// WASD or the arrow keys move the cube{{ if .Scaffold.physics }}; Space drops a crate to push around{{ end }}.
package game

import (
	rl "github.com/gen2brain/raylib-go/raylib"
	"github.com/mlange-42/ark/ecs"
	"github.com/struckchure/illusion"
	"github.com/struckchure/illusion/asset"
	"github.com/struckchure/illusion/defaults"
	"github.com/struckchure/illusion/input"
{{- if .Scaffold.physics }}
	"github.com/struckchure/illusion/physics"
{{- end }}
	"github.com/struckchure/illusion/render"
	"github.com/struckchure/illusion/transform"
	"github.com/struckchure/illusion/window"
)

const speed = 5 // units per second

// cameraOffset is where the camera sits relative to the player.
var cameraOffset = rl.Vector3{Y: 6, Z: 9}

// Player is the cube you move.
type Player struct{}
{{- if .Scaffold.physics }}

// Crates is a resource with what dropped crates are made of.
type Crates struct {
	Mesh     asset.Handle[render.Mesh]
	Material asset.Handle[render.StandardMaterial]
}
{{- end }}

// App is the game, ready to Run.
func App() *illusion.App {
	return illusion.New().
		AddPlugins(
			defaults.Plugins(defaults.Config{
				Window:    window.Config{Title: "{{ .Project }}", MSAA: true},
				AssetRoot: "assets",
			}),
{{- if .Scaffold.physics }}
			physics.Plugin{},
{{- end }}
		).
		AddSystems(illusion.Startup, illusion.Fn4(setup)).
		AddSystems(illusion.Update, illusion.Chain(illusion.Fn3(move), illusion.Fn2(follow)){{ if .Scaffold.physics }}, illusion.Fn4(dropCrate){{ end }}).
		AddSystems(illusion.Render, illusion.Fn0(hud).InSet(render.Draw2D))
}

func setup(
	cmd *illusion.Commands,
	meshes *illusion.Res[asset.Assets[render.Mesh]],
	materials *illusion.Res[asset.Assets[render.StandardMaterial]],
	textures *asset.Loader[render.Texture],
) {
	m, mat := meshes.Get(), materials.Get()
	cmd.Spawn(
		illusion.C(render.Camera3d{}),
		illusion.C(transform.FromTranslation(cameraOffset).LookingAt(rl.Vector3{}, transform.Up)),
	)
	cmd.Spawn(
		illusion.C(render.DirectionalLight{Color: rl.White}),
		illusion.C(transform.Identity().LookingAt(rl.Vector3{X: -1, Y: -3, Z: -2}, transform.Up)),
	)
	cmd.Spawn(
		illusion.C(render.Mesh3d{Mesh: m.Add(render.Plane(20, 20))}),
		// Loaded from assets/checker.png, which web builds bundle into the page.
		illusion.C(render.MeshMaterial3d{Material: mat.Add(render.StandardMaterial{BaseColor: rl.White, Texture: textures.MustLoad("checker.png")})}),
		illusion.C(transform.Identity()),
{{- if .Scaffold.physics }}
		illusion.C(physics.Static),
		illusion.C(physics.Cuboid(20, 1, 20).WithOffset(rl.Vector3{Y: -0.5})),
{{- end }}
	)
	cmd.Spawn(
		illusion.C(Player{}),
		illusion.C(render.Mesh3d{Mesh: m.Add(render.Cuboid(1, 1, 1))}),
		illusion.C(render.MeshMaterial3d{Material: mat.Add(render.StandardMaterial{BaseColor: rl.Orange})}),
		illusion.C(transform.FromXYZ(0, 0.5, 0)),
{{- if .Scaffold.physics }}
		// Kinematic: it follows its Transform and pushes crates out of the way.
		illusion.C(physics.Kinematic),
		illusion.C(physics.Cuboid(1, 1, 1)),
{{- end }}
	)
{{- if .Scaffold.physics }}
	cmd.InsertResource(illusion.R(&Crates{
		Mesh:     m.Add(render.Cuboid(0.8, 0.8, 0.8)),
		Material: mat.Add(render.StandardMaterial{BaseColor: rl.Brown}),
	}))
{{- end }}
}

func move(
	q *illusion.Query1Where[transform.Transform, illusion.With[Player]],
	keys *illusion.Res[input.Keys],
	t *illusion.Res[illusion.Time],
) {
	k := keys.Get()
	var dir rl.Vector3
	if k.AnyPressed(rl.KeyA, rl.KeyLeft) {
		dir.X--
	}
	if k.AnyPressed(rl.KeyD, rl.KeyRight) {
		dir.X++
	}
	if k.AnyPressed(rl.KeyW, rl.KeyUp) {
		dir.Z--
	}
	if k.AnyPressed(rl.KeyS, rl.KeyDown) {
		dir.Z++
	}
	if dir == (rl.Vector3{}) {
		return
	}
	step := rl.Vector3Scale(rl.Vector3Normalize(dir), speed*t.Get().DeltaSecs())
	q.Each(func(_ ecs.Entity, tr *transform.Transform) {
		tr.Translation.X = rl.Clamp(tr.Translation.X+step.X, -9.5, 9.5)
		tr.Translation.Z = rl.Clamp(tr.Translation.Z+step.Z, -9.5, 9.5)
	})
}

// follow keeps the camera behind the player.
func follow(
	players *illusion.Query1Where[transform.Transform, illusion.With[Player]],
	cameras *illusion.Query1Where[transform.Transform, illusion.With[render.Camera3d]],
) {
	_, player, ok := players.Single()
	if !ok {
		return
	}
	target := player.Translation
	cameras.Each(func(_ ecs.Entity, tr *transform.Transform) {
		tr.Translation = rl.Vector3Add(target, cameraOffset)
		tr.LookAt(target, transform.Up)
	})
}
{{- if .Scaffold.physics }}

// dropCrate drops a crate next to the player when Space is pressed.
func dropCrate(
	cmd *illusion.Commands,
	keys *illusion.Res[input.Keys],
	crates *illusion.Res[Crates],
	players *illusion.Query1Where[transform.Transform, illusion.With[Player]],
) {
	if !keys.Get().JustPressed(rl.KeySpace) {
		return
	}
	_, player, ok := players.Single()
	if !ok {
		return
	}
	c := crates.Get()
	cmd.Spawn(
		illusion.C(render.Mesh3d{Mesh: c.Mesh}),
		illusion.C(render.MeshMaterial3d{Material: c.Material}),
		illusion.C(transform.FromXYZ(player.Translation.X, 5, player.Translation.Z-2)),
		illusion.C(physics.Dynamic),
		illusion.C(physics.Cuboid(0.8, 0.8, 0.8)),
	)
}
{{- end }}

func hud() {
	rl.DrawFPS(10, 10)
	rl.DrawText("WASD / arrows: move{{ if .Scaffold.physics }}   space: drop a crate{{ end }}", 10, 36, 20, rl.RayWhite)
}
{{- end }}
